{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kiln cast 清单（版本 1）",
  "description": "供编辑器自动补全与静态校验使用。运行时以 packages/grain/src/manifest.ts 的校验器为准，两者规则保持一致。",
  "type": "object",
  "required": ["id", "version", "title", "summary", "intents", "shape", "verbs", "entry", "tools"],
  "properties": {
    "$schema": { "type": "string", "description": "相对本文件的 JSON Schema 路径" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$",
      "description": "cast 唯一标识，小写字母开头，长度 2–48"
    },
    "version": { "type": "string", "minLength": 1, "description": "语义化版本号" },
    "title": { "type": "string", "minLength": 1, "description": "给人看的标题" },
    "summary": { "type": "string", "minLength": 1, "description": "一句话说明解决什么问题" },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "供发现层匹配任务的意图词"
    },
    "shape": {
      "type": "string",
      "enum": ["task", "panel"],
      "description": "task 必须有 invoke；panel 必须同时有 observe 与 act"
    },
    "verbs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["describe", "invoke", "observe", "act"] },
      "description": "对外暴露的动词，必须包含 describe"
    },
    "entry": {
      "type": "object",
      "required": ["kind", "module"],
      "properties": {
        "kind": { "type": "string", "enum": ["local", "service"], "description": "service 尚未实现" },
        "module": { "type": "string", "minLength": 1, "description": "相对 cast 目录的入口模块路径" }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose", "examples"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,47}$" },
          "purpose": { "type": "string", "minLength": 1 },
          "args": { "type": "object", "additionalProperties": { "type": "string" } },
          "returns": { "type": "string" },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["call", "result"],
              "properties": {
                "call": { "type": "object" },
                "result": {},
                "note": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "description": "每个工具至少一条真实的 call + result 示例"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
          "purpose": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "grants": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "object",
          "required": ["allow"],
          "properties": { "allow": { "type": "array", "items": { "type": "string" } } },
          "additionalProperties": false
        },
        "net": {
          "type": "object",
          "required": ["allow"],
          "properties": { "allow": { "type": "array", "items": { "type": "string" } } },
          "additionalProperties": false
        },
        "store": {
          "type": "object",
          "required": ["scope"],
          "properties": { "scope": { "type": "string", "enum": ["cast", "workspace"] } },
          "additionalProperties": false
        },
        "file": {
          "type": "object",
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "model": { "type": "object", "description": "已进类型，尚无驱动实现" },
        "agent": { "type": "object", "description": "已进类型，尚无驱动实现" }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "observeBytes": { "type": "number", "minimum": 1 },
        "tools": { "type": "number", "minimum": 1 },
        "actions": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
